# AutoHotkey compiled executables (exclude temporary builds)
*_temp.exe
*_debug.exe

# Configuration files with sensitive data (exclude only sensitive ones)
config.ini
settings.ini
credentials.ini

# Language files (keep only source)
lang/*.json

# Temporary files
*.tmp
*.temp
*.log

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Windows files
Thumbs.db
Desktop.ini

# macOS files
.DS_Store

# Linux files
*~

# Build artifacts
build/
dist/
out/

# Node modules (if any)
node_modules/

# Package files (exclude only compressed archives except main distribution)
*_backup.zip
*_temp.zip
*.rar
*.7z

# Documentation build
docs/_build/

# Backup files
*.bak
*.backup
